# ==============================================================================
# .env.example - Template for Secrets Only
# ==============================================================================
# ⚠️ This file is a TEMPLATE - it is NOT loaded by the app!
#
# To use:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your actual secrets in .env
#   3. Never commit .env to git
#
# Non-sensitive defaults are in .env.local (committed to repo).
# This example only shows SECRETS that must be in .env (gitignored).

# ------------------------------------------------------------------------------
# Required Secrets (Production)
# ------------------------------------------------------------------------------
# JWT Secret - Generate with: openssl rand -base64 32
JWT_SECRET=your-generated-secret-here

# Apple Sign-In (from Apple Developer Portal)
APPLE_CLIENT_ID=com.yourcompany.yourapp
APPLE_AUTH_REDIRECT_URI=https://yourapp.com/auth/apple/callback
APPLE_AUTH_KEY_ID=ABC123DEFG
APPLE_AUTH_TEAM_ID=L498CF4FP9
APPLE_AUTH_PRIVATE_KEY_PATH=./auth_keys/AuthKey_ABC123DEFG.p8

# ------------------------------------------------------------------------------
# Supabase Configuration (Optional - for cloud sync)
# ------------------------------------------------------------------------------
# Get from: https://app.supabase.com/project/_/settings/api
# Note: EXPO_PUBLIC_ prefix makes these accessible in client bundle
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️ Service Role Key (BACKEND ONLY - never expose to client)
# SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Database (Backend Only - if self-hosting)
# ------------------------------------------------------------------------------
# DATABASE_PASSWORD=your-db-password
# DATABASE_URL=postgresql://postgres:${DATABASE_PASSWORD}@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Analytics/Monitoring (Optional)
# ------------------------------------------------------------------------------
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
# EXPO_PUBLIC_OWNER=your_expo_username
# EAS_PROJECT_ID=your_eas_project_uuid