# .env.local - Non-Sensitive Configuration

NODE_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:3000
API_TIMEOUT_MS=10000
LOG_LEVEL=info

RATE_LIMIT_WINDOW=86400
RATE_LIMIT_NUDGES_PER_PAIR=3
RATE_LIMIT_NUDGES_PER_USER=10

# Apple Sign-In (disabled for local dev)
ENABLE_APPLE_AUTH=false
APPLE_CLIENT_ID=com.social.accountability.dev

# JWT Secret for auth tokens (dev only - replace in production)
JWT_SECRET=dev-jwt-secret-replace-in-production

# HealthKit integration
ENABLE_HEALTHKIT=false

# Supabase cloud sync
ENABLE_CLOUD_SYNC=false